# --- Banco ---
DATABASE_URL=postgres://contentpilot:contentpilot@localhost:5433/contentpilot

# --- Auth (apps/web) ---
# Gere com: openssl rand -base64 32  (ou: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
AUTH_SECRET=troque-me
AUTH_URL=http://localhost:3000

# Administrador criado pelo seed; e-mail reservado, bloqueado no cadastro público.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-me

# --- Vault de credenciais (AES-256-GCM) ---
# Formato: "<keyId>:<base64 de 32 bytes>[,<keyId2>:<...>]"
# Gere a chave com: node -e "console.log('k1:'+crypto.randomBytes(32).toString('base64'))"
VAULT_MASTER_KEYS=k1:troque-me
VAULT_ACTIVE_KEY_ID=k1

# --- E-mail transacional (Resend) ---
# RESERVA: o caminho preferido é /admin/settings, onde a chave fica cifrada no
# cofre e o remetente vira config editável sem deploy.
# Sem isto, recuperação de senha e confirmação de e-mail ficam inativas: o
# formulário responde normalmente, mas nenhuma mensagem sai.
# O domínio do remetente precisa estar verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM=Content Pilot <no-reply@seudominio.com>

# --- Worker ---
WORKER_CONCURRENCY=2

# Lançamento gratuito: checkout e ofertas pagas desligados.
# Todos os demais usuários cadastram suas próprias chaves de IA/busca (BYOK).
# Apenas a conta ativa ADMIN_EMAIL pode usar as chaves de IA/busca do sistema.
BILLING_ENABLED=false

# --- Stripe (Fase 5 — SaaS) ---
# RESERVA: o caminho preferido é cadastrar as chaves em /admin/settings, onde
# ficam cifradas no cofre e podem ser giradas sem deploy. Os valores abaixo só
# são usados quando não há credencial de plataforma correspondente no banco.
# Webhook local: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs recorrentes dos planos compráveis (crie no dashboard do Stripe)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
