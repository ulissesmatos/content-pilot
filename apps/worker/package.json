{
  "name": "worker",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dry-run": "tsx src/cli/dry-run.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@content-pilot/core": "workspace:*",
    "@content-pilot/db": "workspace:*",
    "cron-parser": "^5.6.1",
    "dotenv": "^17.4.2",
    "pg-boss": "^12.25.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.9"
  }
}
