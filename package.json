{
  "name": "content-pilot",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter worker dev",
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @content-pilot/db generate",
    "db:migrate": "pnpm --filter @content-pilot/db migrate",
    "db:seed": "pnpm --filter @content-pilot/db seed",
    "test:integration": "pnpm --filter @content-pilot/db test:integration"
  }
}
